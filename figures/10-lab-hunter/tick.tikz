\begin{tikzpicture}[x=10mm, y=10mm, node distance=0mm]

  % ================= Фазы такта =================
  \node[proc, minimum width=60mm, font=\scriptsize] (p1) at (0, 4)
       {\textbf{\normalsize 1. Раздача}\\[1mm]
        движок выдаёт каждому агенту только то,\\что попадает в его обзор};
  \node[proc, minimum width=60mm, font=\scriptsize] (p2) at (0, 2.5)
       {\textbf{\normalsize 2. Решение}\\[1mm]
        все объявляют ход \emph{одновременно};\\чужого решения не знает никто};
  \node[proc, minimum width=60mm, font=\scriptsize] (p3) at (0, 1)
       {\textbf{\normalsize 3. Исполнение}\\[1mm]
        движок двигает всех сразу; заход на дорогую\\клетку занимает несколько тактов};
  \node[proc, minimum width=60mm, font=\scriptsize] (p4) at (0, -0.5)
       {\textbf{\normalsize 4. Разбор}\\[1mm]
        поимка, подбор припасов и энергайзеров};

  \draw[arr] (p1) -- (p2);
  \draw[arr] (p2) -- (p3);
  \draw[arr] (p3) -- (p4);
  \draw[arrmuted] (p4.west) -- ++(-1.2, 0) |- (p1.west);
  \node[lbl, rotate=90] at (-3.5, 1.75) {следующий такт};

  % ================= Два способа поимки =================
  \begin{scope}[shift={(5.6, 3.55)}, x=8mm, y=8mm]
    \node[lbl, font=\scriptsize\bfseries, anchor=west] at (-0.6, 1.3)
         {Поимка N1: одна клетка};
    \foreach \x in {0,...,2}
      \fill[boxfill] (\x-0.5, -0.5) rectangle (\x+0.5, 0.5);
    \draw[muted, line width=0.3pt, step=1] (-0.5, -0.5) grid (2.5, 0.5);
    \node[circle, draw=accentb, fill=accentb!30!mixbg, line width=1pt,
          minimum size=5.5mm, inner sep=0pt, font=\tiny] at (0, 0) {Б};
    \node[circle, draw=accent, fill=accent!30!mixbg, line width=1pt,
          minimum size=5.5mm, inner sep=0pt, font=\tiny] at (2, 0) {О};
    \draw[arracc] (0.15, 0.42) to[bend left=35] (0.85, 0.42);
    \draw[arracc] (1.85, 0.42) to[bend right=35] (1.15, 0.42);
    \node[lbl, anchor=west, align=left] at (2.8, 0)
         {оба шагнули\\в клетку 1};
  \end{scope}

  \begin{scope}[shift={(5.6, 1.5)}, x=8mm, y=8mm]
    \node[lbl, font=\scriptsize\bfseries, anchor=west] at (-0.6, 1.3)
         {Поимка N2: размен местами};
    \foreach \x in {0,1}
      \fill[boxfill] (\x-0.5, -0.5) rectangle (\x+0.5, 0.5);
    \draw[muted, line width=0.3pt, step=1] (-0.5, -0.5) grid (1.5, 0.5);
    \node[circle, draw=accentb, fill=accentb!30!mixbg, line width=1pt,
          minimum size=5.5mm, inner sep=0pt, font=\tiny] at (0, 0) {Б};
    \node[circle, draw=accent, fill=accent!30!mixbg, line width=1pt,
          minimum size=5.5mm, inner sep=0pt, font=\tiny] at (1, 0) {О};
    \draw[arracc] (0.15, 0.42) to[bend left=35] (0.85, 0.42);
    \draw[arracc] (0.85, -0.42) to[bend left=35] (0.15, -0.42);
    \node[lbl, anchor=west, align=left] at (1.8, 0)
         {прошли сквозь\\друг друга -\\тоже поимка};
  \end{scope}

  \node[lbl, anchor=north west, align=left] at (2.9, -0.1)
       {Одновременность меняет всё. При ходе по очереди беглец видит,\\
        куда встал охотник, и уходит наверняка. Здесь он ходит вслепую\\
        и должен рассуждать не \emph{где охотник сейчас},\\
        а \emph{куда он способен шагнуть}. Это уже задача\\
        о вероятностях, а не о кратчайшем пути.};

\end{tikzpicture}
