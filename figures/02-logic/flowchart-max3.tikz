\begin{tikzpicture}[x=10mm, y=10mm]

  \node[term]           (start) at ( 0,  2.6) {Начало};
  \node[proc]           (read)  at ( 0,  1.3) {Ввести $A$, $B$, $C$};
  \node[dec]            (ab)    at ( 0,  0.0) {$A > B$?};

  \node[dec]            (ac)    at (-3.4, -1.7) {$A > C$?};
  \node[dec]            (bc)    at ( 3.4, -1.7) {$B > C$?};

  \node[proc, minimum width=18mm] (maxA)  at (-5.3, -3.6) {$max \gets A$};
  \node[proc, minimum width=18mm] (maxC1) at (-1.8, -3.6) {$max \gets C$};
  \node[proc, minimum width=18mm] (maxB)  at ( 1.8, -3.6) {$max \gets B$};
  \node[proc, minimum width=18mm] (maxC2) at ( 5.3, -3.6) {$max \gets C$};

  \node[proc]           (print) at ( 0, -5.6) {Вывести $max$};
  \node[term]           (end)   at ( 0, -6.9) {Конец};

  \draw[arr] (start) -- (read);
  \draw[arr] (read)  -- (ab);

  \draw[arr] (ab.west) -| node[pos=0.22, above, lbl] {да}  (ac.north);
  \draw[arr] (ab.east) -| node[pos=0.22, above, lbl] {нет} (bc.north);

  \draw[arr] (ac.west) -| node[pos=0.25, above, lbl] {да}  (maxA.north);
  \draw[arr] (ac.east) -| node[pos=0.25, above, lbl] {нет} (maxC1.north);
  \draw[arr] (bc.west) -| node[pos=0.25, above, lbl] {да}  (maxB.north);
  \draw[arr] (bc.east) -| node[pos=0.25, above, lbl] {нет} (maxC2.north);

  \draw[draw=fg] (maxA)  -- ++(0, -0.9) -| (print.north);
  \draw[draw=fg] (maxC1) -- ++(0, -0.9) -| (print.north);
  \draw[draw=fg] (maxB)  -- ++(0, -0.9) -| (print.north);
  \draw[draw=fg] (maxC2) -- ++(0, -0.9) -| (print.north);
  \draw[arr] (0, -4.5) -- (print.north);

  \draw[arr] (print) -- (end);

\end{tikzpicture}
