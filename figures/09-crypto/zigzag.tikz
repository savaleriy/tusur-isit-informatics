\begin{tikzpicture}[x=7mm, y=10mm]

  % Три строки
  \foreach \r in {1,2,3} {
    \node[lbl, anchor=east] at (-0.4, -\r + 1) {строка \r};
    \draw[muted, densely dotted] (-0.1, -\r + 1) -- (9.5, -\r + 1);
  }

  % Зигзагообразная линия заполнения
  \draw[accent, line width=1.2pt, rounded corners=2pt]
    (0, 0) -- (0.5, -1) -- (1.0, -2) -- (1.5, -1) -- (2.0, 0)
    -- (2.5, -1) -- (3.0, -2) -- (3.5, -1) -- (4.0, 0)
    -- (4.5, -1) -- (5.0, -2) -- (5.5, -1) -- (6.0, 0)
    -- (6.5, -1) -- (7.0, -2) -- (7.5, -1) -- (8.0, 0)
    -- (8.5, -1) -- (9.0, -2);

  \node[lbl, anchor=west, align=left] at (9.8, -0.5)
    {запись идёт зигзагом\\сверху вниз и обратно};

  \node[lbl, anchor=west] at (9.8, -2.3) {чтение --- построчно};

\end{tikzpicture}
