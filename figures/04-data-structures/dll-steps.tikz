\begin{tikzpicture}[x=17mm, y=12mm]

  % Узлы со связями в обе стороны: next сверху, prev снизу
  \tikzset{
    nxt/.style={->, draw=fg},
    prv/.style={->, draw=muted},
  }

  % 1. append(C): новый узел цепляется к хвосту
  \node[lbl, anchor=east] at (-0.7, 0) {append(C)};
  \node[cell] (a1) at (0, 0) {A};
  \node[cell] (b1) at (1, 0) {B};
  \node[cell, hi2] (c1) at (2, 0) {C};
  \draw[nxt] ([yshift=1.3mm]a1.east) -- ([yshift=1.3mm]b1.west);
  \draw[prv] ([yshift=-1.3mm]b1.west) -- ([yshift=-1.3mm]a1.east);
  \draw[arracc] ([yshift=1.3mm]b1.east) -- ([yshift=1.3mm]c1.west);
  \draw[arracc] ([yshift=-1.3mm]c1.west) -- ([yshift=-1.3mm]b1.east);
  \node[box] (t1) at (2, 1.1) {tail};
  \draw[arracc] (t1) -- (c1);
  \node[lbl, anchor=west, align=left] at (2.7, 0.2)
    {B.next = C, C.prev = B,\\tail = C: обхода нет, $O(1)$};

  % 2. delete(B): соседи смотрят друг на друга
  \node[lbl, anchor=east] at (-0.7, -2.2) {delete(B)};
  \node[cell] (a2) at (0, -2.2) {A};
  \node[ghost] (b2) at (1, -3.1) {B};
  \node[cell] (c2) at (2, -2.2) {C};
  \draw[arracc] ([yshift=1.3mm]a2.east) -- ([yshift=1.3mm]c2.west);
  \draw[arracc] ([yshift=-1.3mm]c2.west) -- ([yshift=-1.3mm]a2.east);
  \node[lbl, anchor=west, align=left] at (2.7, -2.2)
    {B.prev.next = B.next\\B.next.prev = B.prev};

  % 3. delete(C): удаляем хвост
  \node[lbl, anchor=east] at (-0.7, -5.0) {delete(C)};
  \node[cell] (a3) at (0, -5.0) {A};
  \node[ghost] (c3) at (1, -5.8) {C};
  \node[lbl] (n3) at (1, -5.0) {None};
  \draw[arracc] (a3) -- (n3);
  \node[box] (t3) at (0, -3.95) {tail};
  \draw[arracc] (t3) -- (a3);
  \node[lbl, anchor=west, align=left] at (2.7, -5.0)
    {справа соседа нет:\\хвостом становится A, A.next = None};

\end{tikzpicture}
