\begin{tikzpicture}[x=10mm, y=12mm]

  % Подписи номеров ячеек
  \foreach \i in {0, ..., 7} {
    \node[lbl] at (\i, 0.65) {\i};
  }

  % 1. enqueue a, b, c, d
  \node[lbl, anchor=east] at (-0.7, 0) {enqueue a, b, c, d};
  \foreach \v [count=\i from 0] in {a, b, c, d} {
    \node[cell, hi] at (\i, 0) {\v};
  }
  \node[lbl, anchor=west] at (8.0, 0) {head 0, size 4: полно};

  % 2. dequeue дважды
  \node[lbl, anchor=east] at (-0.7, -1.4) {dequeue $\times 2$};
  \node[cell] at (0, -1.4) {};
  \node[cell] at (1, -1.4) {};
  \node[cell, hi] at (2, -1.4) {c};
  \node[cell, hi] at (3, -1.4) {d};
  \node[lbl, anchor=west] at (8.0, -1.4) {head 2, size 2: ничего не сдвигалось};

  % 3. enqueue e, f: переход через край
  \node[lbl, anchor=east] at (-0.7, -2.8) {enqueue e, f};
  \node[cell, hi2] (e) at (0, -2.8) {e};
  \node[cell, hi2] at (1, -2.8) {f};
  \node[cell, hi] at (2, -2.8) {c};
  \node[cell, hi] (d) at (3, -2.8) {d};
  \draw[arracc, rounded corners=3pt] (d.south) -- ++(0, -0.25) -| (e.south);
  \node[lbl, anchor=west, align=left] at (8.0, -2.8) {$(2 + 2) \bmod 4 = 0$:\\e встаёт в ячейку 0};

  % 4. enqueue g: рост и разворот
  \node[lbl, anchor=east] at (-0.7, -4.4) {enqueue g};
  \foreach \v [count=\i from 0] in {c, d, e, f} {
    \node[cell, hi] at (\i, -4.4) {\v};
  }
  \node[cell, hi2] at (4, -4.4) {g};
  \foreach \i in {5, 6, 7} {
    \node[cell] at (\i, -4.4) {};
  }
  \node[lbl, anchor=west, align=left] at (8.0, -4.4) {места нет: блок из 8,\\очередь переписана с head};

\end{tikzpicture}
