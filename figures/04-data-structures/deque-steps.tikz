\begin{tikzpicture}[x=10mm, y=12mm]

  \foreach \i in {0, ..., 3} {
    \node[lbl] at (\i, 0.65) {\i};
  }

  % 1. push_back(1), push_back(2)
  \node[lbl, anchor=east] at (-0.7, 0) {push\_back(1), push\_back(2)};
  \node[cell, hi] at (0, 0) {1};
  \node[cell, hi] at (1, 0) {2};
  \node[cell] at (2, 0) {};
  \node[cell] at (3, 0) {};
  \node[lbl, anchor=west] at (4.0, 0) {head 0, size 2};

  % 2. push_front(0): head шагает назад по кругу
  \node[lbl, anchor=east] at (-0.7, -1.6) {push\_front(0)};
  \node[cell, hi] (one) at (0, -1.6) {1};
  \node[cell, hi] at (1, -1.6) {2};
  \node[cell] at (2, -1.6) {};
  \node[cell, hi2] (zero) at (3, -1.6) {0};
  \draw[arracc, rounded corners=3pt] (one.south) -- ++(0, -0.25) -| (zero.south);
  \node[lbl, anchor=west, align=left] at (4.0, -1.6)
    {head $= (0 - 1) \bmod 4 = 3$, size 3:\\порядок 0, 1, 2 - с ячейки 3 по кругу};

  % 3. pop_back(): конец - ячейка (3 + 3 - 1) mod 4 = 1
  \node[lbl, anchor=east] at (-0.7, -3.2) {pop\_back() вернул 2};
  \node[cell, hi] at (0, -3.2) {1};
  \node[cell] at (1, -3.2) {};
  \node[cell] at (2, -3.2) {};
  \node[cell, hi] at (3, -3.2) {0};
  \node[lbl, anchor=west, align=left] at (4.0, -3.2)
    {конец - ячейка $(3 + 3 - 1) \bmod 4 = 1$;\\head 3, size 2};

  % 4. pop_front(): head шагает вперёд по кругу
  \node[lbl, anchor=east] at (-0.7, -4.6) {pop\_front() вернул 0};
  \node[cell, hi] at (0, -4.6) {1};
  \node[cell] at (1, -4.6) {};
  \node[cell] at (2, -4.6) {};
  \node[cell] at (3, -4.6) {};
  \node[lbl, anchor=west] at (4.0, -4.6) {head $= (3 + 1) \bmod 4 = 0$, size 1};

\end{tikzpicture}
