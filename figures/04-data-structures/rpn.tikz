\begin{tikzpicture}[x=13mm, y=10mm]

  % Токены 5 1 2 + 4 * + 3 - и стек после каждого
  \foreach \tok/\x in {5/0, 1/1, 2/2, +/3, 4/4, */5, +/6, 3/7, -/8} {
    \node[box] at (\x, 3.1) {\texttt{\tok}};
    \draw[muted] (\x - 0.35, -0.45) -- (\x + 0.35, -0.45);
  }
  % 5
  \node[cell] at (0, 0) {5};
  % 5 1
  \node[cell] at (1, 0) {5};
  \node[cell] at (1, 0.75) {1};
  % 5 1 2
  \node[cell] at (2, 0) {5};
  \node[cell] at (2, 0.75) {1};
  \node[cell] at (2, 1.5) {2};
  % + : 1 + 2
  \node[cell] at (3, 0) {5};
  \node[cell, hi] at (3, 0.75) {3};
  % 4
  \node[cell] at (4, 0) {5};
  \node[cell] at (4, 0.75) {3};
  \node[cell] at (4, 1.5) {4};
  % * : 3 * 4
  \node[cell] at (5, 0) {5};
  \node[cell, hi] at (5, 0.75) {12};
  % + : 5 + 12
  \node[cell, hi] at (6, 0) {17};
  % 3
  \node[cell] at (7, 0) {17};
  \node[cell] at (7, 0.75) {3};
  % - : 17 - 3
  \node[cell, hi2] at (8, 0) {14};

  \node[lbl, anchor=west, align=left] at (-0.4, -1.2)
    {число кладём в стек; оператор снимает два верхних и кладёт результат (выделен);\\
     порядок важен: для \texttt{-} сначала снимается вычитаемое 3, потом уменьшаемое 17};

\end{tikzpicture}
