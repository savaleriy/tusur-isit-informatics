\begin{tikzpicture}[x=11mm, y=11mm]

  % Шапка: вместимость
  \node[lbl] at (0, 0) {предмет};
  \foreach \w in {0,...,5} {
    \node[lbl] at (\w + 1, 0) {\w};
  }
  \node[lbl, anchor=west] at (7.2, 0) {вместимость};

  % Строка без предметов
  \node[cell, minimum width=14mm] at (0, 1) {-};
  \foreach \w in {0,...,5} {
    \node[cell, minimum width=10mm] at (\w + 1, 1) {0};
  }

  % (2, 3)
  \node[cell, minimum width=14mm] at (0, 2) {(2,3)};
  \foreach \w/\v in {0/0, 1/0, 2/3, 3/3, 4/3, 5/3} {
    \node[cell, minimum width=10mm] at (\w + 1, 2) {\v};
  }

  % (3, 4)
  \node[cell, minimum width=14mm] at (0, 3) {(3,4)};
  \foreach \w/\v in {0/0, 1/0, 2/3, 3/4, 4/4, 5/7} {
    \node[cell, minimum width=10mm] at (\w + 1, 3) {\v};
  }

  % (4, 5)
  \node[cell, minimum width=14mm] at (0, 4) {(4,5)};
  \foreach \w/\v in {0/0, 1/0, 2/3, 3/4, 4/5, 5/7} {
    \node[cell, minimum width=10mm] at (\w + 1, 4) {\v};
  }

  % Ответ
  \node[hi, minimum width=10mm] at (6, 4) {7};

  \node[lbl, anchor=west, align=left] at (7.2, 2.6)
    {предмет = (вес, стоимость);\\в клетке --- максимум стоимости};

\end{tikzpicture}
