\begin{tikzpicture}[x=16mm, y=15mm,
  tnode/.style={circle, draw=fg, fill=boxfill, text=fg, inner sep=1pt, minimum size=8mm}]

  \node[tnode] (A) at (0, 1.4) {A};
  \node[tnode] (B) at (1.3, 1.0) {B};
  \node[tnode] (C) at (1.3, -0.2) {C};
  \node[tnode] (D) at (0.3, -1.2) {D};
  \node[tnode] (E) at (-0.8, -0.2) {E};

  % рёбра остова (минимальное остовное дерево)
  \draw[accent, line width=1.2pt] (A) -- (B) node[midway, above, accent] {2};
  \draw[accent, line width=1.2pt] (B) -- (C) node[midway, right, accent] {1};
  \draw[accent, line width=1.2pt] (B) -- (D) node[pos=0.25, left=1mm, accent] {4};
  \draw[accent, line width=1.2pt] (C) -- (E) node[midway, below, accent] {2};

  % остальные рёбра
  \draw[muted, densely dashed] (A) -- (C) node[midway, left, muted] {3};
  \draw[muted, densely dashed] (C) -- (D) node[midway, right, muted] {5};
  \draw[muted, densely dashed] (D) -- (E) node[midway, below, muted] {6};

  \node[lbl, anchor=north, align=center] at (0.25, -2.1)
    {жадный выбор --- тянуть провод к ближайшему посёлку\\даёт минимальный остов (сумма 9)};

\end{tikzpicture}
