\begin{tikzpicture}[x=16mm, y=-15mm,
  tnode/.style={circle, draw=fg, fill=boxfill, text=fg, inner sep=1pt, minimum size=8mm}]

  \node[tnode] (n1) at (0, 0) {1};
  \node[tnode] (n2) at (-1, 1) {2};
  \node[tnode] (n3) at (1, 1) {3};
  \node[tnode] (n4) at (-1.6, 2) {4};
  \node[tnode] (n5) at (-0.4, 2) {5};
  \draw[wire] (n1) -- (n2);
  \draw[wire] (n1) -- (n3);
  \draw[wire] (n2) -- (n4);
  \draw[wire] (n2) -- (n5);

  \node[lbl, anchor=west] at (2.0, 0) {pre-order: 1 2 4 5 3};
  \node[lbl, anchor=west] at (2.0, 1) {in-order: 4 2 5 1 3};
  \node[lbl, anchor=west] at (2.0, 2) {post-order: 4 5 2 3 1};

\end{tikzpicture}
