\begin{tikzpicture}[x=15mm, y=15mm,
  tnode/.style={circle, draw=fg, fill=boxfill, text=fg, inner sep=1pt, minimum size=8mm}]

  \node[tnode] (r) at (0, 2) {1};
  \node[tnode] (a) at (-1.3, 1) {3};
  \node[tnode] (b) at (1.3, 1) {2};
  \node[tnode] (c) at (-1.9, 0) {7};
  \node[tnode] (d) at (-0.7, 0) {5};

  \draw[wire] (r) -- (a);
  \draw[wire] (r) -- (b);
  \draw[wire] (a) -- (c);
  \draw[wire] (a) -- (d);

  % массив-представление
  \node[lbl, anchor=west] at (1.7, 1.5) {то же дерево в массиве:};

  \node[cell] (m0) at (2.1, 0.7) {1};
  \node[cell] (m1) at (3.1, 0.7) {3};
  \node[cell] (m2) at (4.1, 0.7) {2};
  \node[cell] (m3) at (5.1, 0.7) {7};
  \node[cell] (m4) at (6.1, 0.7) {5};
  \node[lbl] at (2.1, 0.15) {0};
  \node[lbl] at (3.1, 0.15) {1};
  \node[lbl] at (4.1, 0.15) {2};
  \node[lbl] at (5.1, 0.15) {3};
  \node[lbl] at (6.1, 0.15) {4};

  \node[lbl, anchor=west] at (1.7, -0.9)
    {потомки узла $i$:\\$2i{+}1$ и $2i{+}2$};

\end{tikzpicture}
