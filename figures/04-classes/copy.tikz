\begin{tikzpicture}[x=10mm, y=10mm]

  % Поверхностная копия: отрезки разные, точки общие
  \node[lbl, anchor=south, font=\ttfamily\scriptsize] at (1.9, 1.3) {s2 = copy.copy(s1)};
  \node[box, minimum width=18mm, font=\ttfamily\small] (s1) at (0, 0.4) {s1};
  \node[box, hi2, minimum width=18mm, font=\ttfamily\small] (s2) at (0, -1.0) {s2};
  \node[cell, minimum width=22mm, font=\ttfamily\small] (a) at (3.7, 0.4) {Point(0, 0)};
  \node[cell, minimum width=22mm, font=\ttfamily\small] (b) at (3.7, -1.0) {Point(3, 4)};
  \draw[arr] (s1.east) -- (a.west);
  \draw[arr] (s1.east) -- (b.west);
  \draw[arr, draw=accentb] (s2.east) -- (a.west);
  \draw[arr, draw=accentb] (s2.east) -- (b.west);
  \node[lbl] at (1.9, -1.9) {поверхностная: точки общие};

  % Глубокая копия: у копии свои точки
  \node[lbl, anchor=south, font=\ttfamily\scriptsize] at (9.1, 1.3) {s3 = copy.deepcopy(s1)};
  \node[box, minimum width=18mm, font=\ttfamily\small] (t1) at (7.2, 0.4) {s1};
  \node[box, hi, minimum width=18mm, font=\ttfamily\small] (t3) at (7.2, -1.0) {s3};
  \node[cell, minimum width=22mm, font=\ttfamily\small, minimum height=6mm] (a1) at (10.9, 0.75) {Point(0, 0)};
  \node[cell, minimum width=22mm, font=\ttfamily\small, minimum height=6mm] (b1) at (10.9, 0.05) {Point(3, 4)};
  \node[cell, hi, minimum width=22mm, font=\ttfamily\small, minimum height=6mm] (a3) at (10.9, -0.65) {Point(0, 0)};
  \node[cell, hi, minimum width=22mm, font=\ttfamily\small, minimum height=6mm] (b3) at (10.9, -1.35) {Point(3, 4)};
  \draw[arr] (t1.east) -- (a1.west);
  \draw[arr] (t1.east) -- (b1.west);
  \draw[arracc] (t3.east) -- (a3.west);
  \draw[arracc] (t3.east) -- (b3.west);
  \node[lbl] at (9.1, -2.1) {глубокая: у копии свои точки};

\end{tikzpicture}
